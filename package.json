{
  "name": "drfab-website",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "hugo server --disableFastRender & npx @tailwindcss/cli -i ./assets/css/main.css -o ./static/css/style.css --watch",
    "build": "npx @tailwindcss/cli -i ./assets/css/main.css -o ./static/css/style.css --minify && hugo --minify"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.12",
    "tailwindcss": "^4.1.12"
  }
}
